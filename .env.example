# Copy this file to .env at repo root.
# This repo uses one root env only.

# -----------------------------
# Contracts / deploy
# -----------------------------
KPEG_LOCAL_RPC_URL=http://127.0.0.1:8545
KPEG_DEPLOYER_PRIVATE_KEY=

# Live-network RPCs are optional; defaults are public Base RPCs below.
# Public Base RPCs are rate-limited and not production-grade.
# KPEG_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# KPEG_BASE_MAINNET_RPC_URL=https://mainnet.base.org
# BaseScan contract verification uses the Etherscan v2 API.
ETHERSCAN_API_KEY=
# Legacy alias accepted by scripts, but the value must be an Etherscan v2 API key.
BASESCAN_API_KEY=
# Optional extra Sourcify verification during contract verification.
KPEG_VERIFY_SOURCIFY=false
# Optional split-key inputs for app env generation:
# backend/serverless sync RPCs:
# BASE_SEPOLIA_RPC=https://your-backend-unrestricted-base-sepolia-rpc
# BASE_RPC=https://your-backend-unrestricted-base-mainnet-rpc
# frontend/browser RPCs:
# BASE_SEPOLIA_RPC_PUBLIC=https://your-browser-whitelisted-base-sepolia-rpc
# BASE_RPC_PUBLIC=https://your-browser-whitelisted-base-mainnet-rpc

# Known live defaults are built into deploy.ts:
# Base Sepolia PoolManager: 0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408
# Base Mainnet PoolManager: 0x498581ff718922c3f8e6a244956af099b2652b2b
# Base WETH9 (both): 0x4200000000000000000000000000000000000006
# Base Sepolia PositionManager: 0x4b2c77d209d3405f41a037ec6c77f7f5b8e2ca80
# Base Mainnet PositionManager: 0x7c5f5a4bbd8fd63184577525326123b519429bdc
# Permit2 (both): 0x000000000022D473030F116dDEE9F6B43aC78BA3
# Override these only if Uniswap/WETH addresses change.
KPEG_POOL_MANAGER_ADDRESS=
KPEG_WETH_ADDRESS=
KPEG_POSITION_MANAGER_ADDRESS=
KPEG_PERMIT2_ADDRESS=

KPEG_POOL_FEE=3000
KPEG_POOL_TICK_SPACING=60
KPEG_HOOK_DEPLOY_GAS_LIMIT=8000000
KPEG_LINK_GAS_LIMIT=200000
KPEG_INITIALIZE_POOL_GAS_LIMIT=800000
KPEG_POSITION_UNSUBSCRIBE_GAS_LIMIT=100000

# Optional pre-start authorized caller reservation.
# Do not set a raw future contract address. Use CREATE2 inputs so deploy.ts derives the address
# and v1 also stores the runtime code hash.
KPEG_BREEDING_CREATE2_DEPLOYER_ADDRESS=
KPEG_BREEDING_CREATE2_SALT=
KPEG_BREEDING_INIT_CODE_HASH=
KPEG_BREEDING_RUNTIME_CODE_HASH=
# Optional birth gateway constructor overrides for prepare/deploy helper scripts.
# Defaults: gateway owner = deployer, initial authorized caller = zero address.
KPEG_BIRTH_GATEWAY_OWNER=
KPEG_BIRTH_GATEWAY_INITIAL_AUTHORIZED_CALLER=

# -----------------------------
# API / sync
# -----------------------------
HOST=0.0.0.0
PORT=8787
NODE_ENV=development
KPEG_CORS_ORIGIN=*

KPEG_DB_MODE=sqlite
# Relative paths are resolved from the repo root by the API.
KPEG_DB_PATH=./apps/indexer/data/kpeg.sqlite
KPEG_LIBSQL_URL=
KPEG_LIBSQL_AUTH_TOKEN=
KPEG_MIGRATE_SQLITE_PATH=./apps/indexer/data/kpeg.sqlite
# Production defaults to read-only API boot; use init-db for schema/identity writes.
KPEG_DB_APPLY_SCHEMA_ON_BOOT=

# Local default only. Cloud app env generation (`cloud-turso`) must resolve this to a public RPC URL.
KPEG_CHAIN_RPC_URL=http://127.0.0.1:8545
# Optional comma/space separated backend RPC failover URLs for indexer sync and onchain repair reads.
KPEG_CHAIN_RPC_FALLBACK_URLS=
KPEG_CHAIN_ID=31337
KPEG_SYNC_MAX_BLOCKS=5000
KPEG_SYNC_LOCK_TTL_MS=55000
KPEG_SYNC_MAX_RUNTIME_MS=110000
KPEG_DEV_AUTO_SYNC=true
KPEG_DEV_SYNC_INTERVAL_MS=60000
KPEG_SYNC_SECRET=
# If true, empty first-page list responses can force one onchain repair attempt.
KPEG_ONCHAIN_FORCE_PAGE_REPAIR=false
# Optional: force the indexer start block for first sync.
# Leave blank when deployments/<network>.json exists; the API auto-hints from deployment metadata.
KPEG_CHAIN_START_BLOCK=
KPEG_DEPLOYED_AT=
KPEG_TOKEN_DEPLOYMENT_BLOCK=

KPEG_TOKEN_ADDRESS=
KPEG_MARKET_ADDRESS=
KPEG_BREEDING_ADDRESS=
KPEG_ROUTER_ADDRESS=
KPEG_QUOTER_ADDRESS=

# -----------------------------
# Web
# -----------------------------
VITE_KPEG_CHAIN_ID=31337
# Reown project ID from the Reown Cloud dashboard.
VITE_REOWN_PROJECT_ID=

VITE_KPEG_TOKEN_ADDRESS=
VITE_KPEG_MARKET_ADDRESS=
VITE_KPEG_ROUTER_ADDRESS=
VITE_KPEG_QUOTER_ADDRESS=

VITE_KPEG_RPC_URL_LOCAL=http://127.0.0.1:8545
# Base Sepolia web RPC:
# VITE_KPEG_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
# Base Mainnet web RPC:
# VITE_KPEG_RPC_URL_BASE_MAINNET=https://mainnet.base.org
# Normal passive refresh interval for Explore, My Collection, Market, and Breeding.
VITE_KPEG_NORMAL_REFETCH_MS=30000
