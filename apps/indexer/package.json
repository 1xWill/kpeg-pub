{
  "name": "@kpeg/indexer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./serverless": {
      "types": "./dist/serverless.d.ts",
      "default": "./dist/serverless.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "init-db": "tsx src/init-db.ts",
    "reconcile:onchain": "tsx src/reconcile-onchain.ts",
    "migrate:sqlite-to-libsql": "tsx src/migrate-sqlite-to-libsql.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@kpeg/core": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "viem": "^2.39.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
